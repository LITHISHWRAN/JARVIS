# ==============================
# JARVIS M3 - Git Ignore
# ==============================

# Python virtual environments
.venv/
venv/
env/

# Python cache
__pycache__/
*.py[cod]
*$py.class

# Testing / coverage
.pytest_cache/
.coverage
htmlcov/
.tox/

# Environment / secrets
.env
.env.*
!.env.example

# Logs
logs/
*.log

# Local runtime data
runtime/
*.pid
*.lock

# Local models
models/
*.gguf
*.bin
*.safetensors
*.pt
*.pth
*.onnx

# IDEs / editors
.vscode/
.idea/
*.code-workspace

# OS files
.DS_Store
Thumbs.db
desktop.ini

# Python packaging
*.egg-info/
dist/
build/
.eggs/

# Temporary files
*.tmp
*.temp
*.bak
*.swp
*.swo

# Jupyter
.ipynb_checkpoints/

# Local databases
*.db
*.sqlite
*.sqlite3

# Windows
$RECYCLE.BIN/

/tests